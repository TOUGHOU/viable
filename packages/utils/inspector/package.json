{
  "name": "@vibe/utils-inspector",
  "version": "0.0.0",
  "description": "Vibe Coding Inspector - JSX 转换、运行时选择/拖拽、Vite/Turbopack 适配器",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime/inject": {
      "types": "./dist/runtime/inject.d.ts",
      "import": "./dist/runtime/inject.js",
      "require": "./dist/runtime/inject.cjs",
      "default": "./dist/runtime/inject.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs",
      "default": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm exec vite build",
    "dev": "pnpm exec vite build --watch",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "magic-string": "^0.30.0"
  },
  "peerDependencies": {
    "@babel/parser": "^7.0.0",
    "@babel/traverse": "^7.0.0",
    "@babel/types": "^7.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/parser": "^7.0.0",
    "@babel/traverse": "^7.0.0",
    "@babel/types": "^7.0.0",
    "@eslint/js": "^9.0.0",
    "@types/babel__traverse": "^7.0.0",
    "@types/node": "^20.10.0",
    "eslint": "^9.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
