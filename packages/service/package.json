{
  "name": "@vibe/service",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "pnpm exec nest build",
    "start": "pnpm exec nest start",
    "dev": "pnpm exec nest start --watch",
    "start:debug": "pnpm exec nest start --debug --watch",
    "lint": "pnpm exec eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "prisma:migrate": "pnpm exec prisma migrate dev",
    "prisma:generate": "pnpm exec prisma generate",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.3.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/adapter-better-sqlite3": "7.2.0",
    "@prisma/client": "7.2.0",
    "@vibe/shared": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.0.0",
    "e2b": "^2.14.1",
    "fs-extra": "^11.3.4",
    "openai": "^6.25.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.3.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.10.0",
    "eslint": "^9.0.0",
    "prisma": "7.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
