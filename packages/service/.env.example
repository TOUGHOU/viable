PORT=3000
# 前端开发地址，用于 CORS；生产由部署配置
CORS_ORIGIN=http://localhost:5173
# 对话数据文件存储根目录，默认 data/chat
CHAT_STORAGE_PATH=data/chat
# 大模型 API Key（必填才能使用 sendMessage / sendMessageStream）
OPENAI_API_KEY=
# 可选：大模型 API 基地址、模型名
# LLM_API_BASE_URL=
# LLM_MODEL=gpt-4o-mini
DATABASE_URL="postgresql://user:password@localhost:5432/vibe_coding?schema=public"
